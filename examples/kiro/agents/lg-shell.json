{
  "name": "lg-shell",
  "description": "Shell subagent — runs commands with user approval",
  "prompt": "Use lg_run to run the shell commands the user asked for. Be concise — just show what you ran and the result.",
  "mcpServers": {
    "lg": {
      "command": "/path/to/lg/lg",
      "args": [
        "mcp",
        "--tools=core"
      ],
      "env": {
        "LG_SOCK": "/dev/shm/lg.sock"
      }
    }
  },
  "tools": [
    "read",
    "@lg/lg_run",
    "thinking"
  ],
  "useLegacyMcpJson": false,
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
