{
  "name": "lg-oneshot",
  "description": "Isolated oneshot edit mode — sees only its own painted region via LG_SESSION",
  "mcpServers": {
    "lg": {
      "command": "/path/to/lg/lg",
      "args": [
        "mcp",
        "--tools=core"
      ],
      "env": {
        "LG_SOCK": "/dev/shm/lg.sock",
        "LG_SESSION": "oneshot"
      }
    },
    "lg-git": {
      "command": "/path/to/lg/lg",
      "args": [
        "mcp",
        "--tools=git"
      ]
    }
  },
  "tools": [
    "grep",
    "glob",
    "thinking",
    "@lg",
    "@lg-git"
  ],
  "useLegacyMcpJson": false,
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  }
}
